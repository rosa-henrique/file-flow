{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "S3": {
    "BucketTemporary": "temporary"
  },
  "FileManagement": {
    "MaxRetry" : 3
  },
  "BucketCleanup": {
    "IntervalMinutes": 15,
    "MinimumAgeMinutes": 60,
    "MaxKeysPerPage": 1000
  }
}
